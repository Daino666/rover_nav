Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
      Color Scheme: costmap
      Alpha: 0.5
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Raw Plan (SmacPlanner2D)
      Topic:
        Value: /unsmoothed_plan
      Color: 25; 25; 25
      Line Style: Lines
      Line Width: 0.03
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Smoothed Plan (SimpleSmoother)
      Topic:
        Value: /plan_smoothed
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.08
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Pure Pursuit Path (followed route)
      Topic:
        Value: /pure_pursuit/path
        Durability Policy: Transient Local
      Color: 255; 128; 0
      Line Style: Lines
      Line Width: 0.1
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
      TF Prefix: ""
      Update Interval: 0
      Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 255; 255; 255
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 25
      X: 0
      Y: 10
