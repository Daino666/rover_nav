<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zed2i_camera">

    <!-- Kinematic model (frames + mesh) comes from the official Stereolabs package -->
    <xacro:include filename="$(find zed_description)/urdf/zed_macro.urdf.xacro" />

    <!-- Mount point, reusing the same chassis location the D435i used -->
    <joint name="zed_camera_mount_joint" type="fixed">
        <origin xyz="0.2756 0.0025 0.2535" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="zed_camera_link"/>
    </joint>

    <xacro:zed_camera name="zed" model="zed2i">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:zed_camera>

    <!-- Gazebo configuration for Ionic/ROS2 Jazzy -->
    <xacro:if value="${enable_zed2i}">
        <gazebo reference="zed_camera_center">
            <self_collide>0</self_collide>
            <enable_wind>0</enable_wind>
            <kinematic>0</kinematic>
            <mu2>1</mu2>
            <fdir1>0 0 0</fdir1>
            <kp>1e+13</kp>
            <kd>1</kd>

            <!-- Left color camera - 15 Hz, matching the rest of the rig's render budget -->
            <sensor name="zed_left_color" type="camera">
                <camera name="zed_left">
                    <horizontal_fov>1.8</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>RGB_INT8</format>
                    </image>
                    <clip>
                        <near>0.2</near>
                        <far>20</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                </camera>
                <always_on>1</always_on>
                <update_rate>15</update_rate>
                <visualize>false</visualize>
                <topic>zed/left/image_rect_color</topic>
                <gz_frame_id>zed_left_camera_frame_optical</gz_frame_id>
            </sensor>

            <!-- Depth, registered to the left camera per ZED SDK convention -->
            <sensor name="zed_depth" type="depth_camera">
                <camera name="zed_depth">
                    <horizontal_fov>1.8</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R_FLOAT32</format>
                    </image>
                    <clip>
                        <near>0.2</near>
                        <far>20</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.010</stddev>
                    </noise>
                </camera>
                <always_on>1</always_on>
                <update_rate>15</update_rate>
                <visualize>false</visualize>
                <topic>zed/depth/depth_registered</topic>
                <gz_frame_id>zed_left_camera_frame_optical</gz_frame_id>
            </sensor>
        </gazebo>
    </xacro:if>
</robot>
