<?xml version="1.0"?>
<model>
  <name>ArUco Marker 61 (L11)</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <description>
    Auto-generated ArUco landmark sign, printed number 11, encoded
    ID 61 (DICT_5X5_100, ERC "5x5 library, numbers 51-65" spec), at
