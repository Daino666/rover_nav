  </gazebo>

  

  <!-- Gazebo Plugin for Pose Publisher -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>100</static_update_frequency>
    </plugin>
  </gazebo>

  <!-- Odometry Plugin -->
  <gazebo>
        <plugin filename="libgz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <odom_topic>/odom</odom_topic>
            <!-- <tf_topic>/model/aries/tf</tf_topic> -->
            <dimensions>2</dimensions>
            <odom_publish_frequency>100</odom_publish_frequency>
        </plugin>
  </gazebo>
    
  <gazebo reference="imu_frame">
      <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>100</update_rate>
          <gz_frame_id>imu_frame</gz_frame_id>
          <visualize>true</visualize>
          <topic>/imu</topic>
          <!-- Without this, gz-sim's IMU zeroes yaw relative to whatever
               orientation the model had when the sensor was instantiated
               (spawn-relative), not true world orientation: roll/pitch
               stay gravity-referenced (correct) but yaw silently drifts off
               by however much the spawn pose was rotated (spawn_yaw in
               my_robot.launch.py), which fed a wrong heading into the EKF
               and desynced RViz's displayed orientation from Gazebo's real
               one. Forcing world-fixed ENU makes yaw absolute. -->
          <imu>
              <orientation_reference_frame>
                  <localization>ENU</localization>
              </orientation_reference_frame>
          </imu>
      </sensor>
  </gazebo>


  <!-- Gazebo Plugin for Diff Drive (disabled when ros2_control handles driving) -->
  <xacro:unless value="$(arg use_sim)">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>L_1_Wheel_Joint</left_joint>
        <left_joint>L_2_Wheel_Joint</left_joint>
        <left_joint>L_3_Wheel_Joint</left_joint>
        <right_joint>R_1_Wheel_Joint</right_joint>
        <right_joint>R_2_Wheel_Joint</right_joint>
        <right_joint>R_3_Wheel_Joint</right_joint>
        <!-- True geometric track width from URDF forward kinematics (see
             rover_controllers/config/diff_controller.yaml), was 0.45 which
             didn't match the actual robot geometry. This plugin is inactive
             under the default launch (use_sim:=true uses ros2_control
             instead), but kept correct in case it's ever re-enabled. -->
        <wheel_separation>0.7095</wheel_separation>
        <wheel_radius>0.1100</wheel_radius>
        <frame_id>odom</frame_id>
        <topic>/model/aries/cmd_vel</topic>
        <child_frame_id>base_footprint</child_frame_id>
      </plugin>
    </gazebo>
  </xacro:unless>


  





    

    

    

</robot>
