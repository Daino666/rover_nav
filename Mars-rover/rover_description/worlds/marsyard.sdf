<sdf version='1.10'>
  <world name='leo_marsyard'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
        <solver>
          <solver_type>dantzig</solver_type>
        </solver>
      </dart>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'>
      <!-- <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
        <collision_detector>bullet</collision_detector>
      </engine> -->
    </plugin>
    <!-- <plugin name="gz::sim::systems::Ros2Tf" filename="gz-sim-ros2-tf-system">
      <publish_tf>true</publish_tf>
      <publish_tf_static>true</publish_tf_static>
    </plugin> -->
     
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <sky>
        <cubemap_uri>dem/milkyway_starry_sky.dds</cubemap_uri>
      </sky>
      <shadows>true</shadows>
    </scene>
    
    <!-- <scene>
      <ambient>0.05 0.05 0.06 1</ambient>
      <background>0.00 0.00 0.02 1</background>
      <sky>
        <cubemap_uri>dem/milkyway_starry_sky.dds</cubemap_uri>
      </sky>
    </scene> -->
    <model name='marsyard2026_terrain'>
      <model name='marsyard2026_terrain'>
        <pose>0 0 0 0 0 0</pose>
        <static>true</static>
        <link name='marsyard_terrain'>
          <collision name='terrain_collision'>
            <geometry>
              <mesh>
                <uri>marsyard_mesh/marsyard2026_collision.obj</uri>
              </mesh>
            </geometry>
          </collision>
          <visual name='terrain_visual'>
            <geometry>
              <mesh>
                <uri>marsyard_mesh/marsyard2026_visual.obj</uri>
              </mesh>
            </geometry>
          </visual>
        </link>
      </model>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Safety-net ground plane: the heightmap only covers the actual scanned
         Mars Yard footprint (~37x44m). Outside that rectangle there is no
         heightmap collision at all, so driving/teleporting past the mapped
         edge means falling into open space. This plane sits well below the
         yard's lowest point (elev min approx -0.86) so it never interferes
         with the yard's own terrain, and only catches the rover if it
         actually leaves the mapped area. -->
    <model name='out_of_bounds_ground_plane'>
      <static>true</static>
      <pose>0.19 14.02 -3.0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 400</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.15 0.1 1</ambient>
            <diffuse>0.25 0.18 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ═══════════════════════════════════════════════════════════════════
         OBSTACLE ROCKS — 3 verified-passable boulders for avoidance testing.
         Removed: rock_2_west_loop (0.4 m corridor, no bypass), rock_4_east_return
         (path squeezed by hills). Remaining rocks have ≥1.0 m clear on one side.
           R1: LEFT=3.0m / RIGHT=1.6m  | R3: RIGHT=1.0m  | R5: RIGHT=1.4m
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Rock 1 — ~12% path, S1 exit. Clearance LEFT=3.0m / RIGHT=1.6m -->
    <model name='rock_1_s1_exit'>
      <static>true</static>
      <pose>-1.709 6.813 0.16 0 0 0.4</pose>
      <link name='body_main'>
        <collision name='col_main'>
          <geometry><box><size>0.55 0.43 0.32</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name='vis_main'>
          <geometry><box><size>0.55 0.43 0.32</size></box></geometry>
          <material>
            <ambient>0.50 0.38 0.25 1</ambient><diffuse>0.50 0.38 0.25 1</diffuse>
            <specular>0.05 0.04 0.03 1</specular>
          </material>
        </visual>
      </link>
      <link name='lobe1'>
        <pose>0.19 0.14 -0.03 0.1 -0.15 0</pose>
        <collision name='col'><geometry><sphere><radius>0.17</radius></sphere></geometry></collision>
        <visual name='vis'>
          <geometry><sphere><radius>0.17</radius></sphere></geometry>
          <material><ambient>0.43 0.32 0.21 1</ambient><diffuse>0.43 0.32 0.21 1</diffuse></material>
        </visual>
      </link>
      <link name='lobe2'>
        <pose>-0.15 -0.10 -0.05 -0.05 0.1 0</pose>
        <collision name='col'><geometry><box><size>0.24 0.19 0.15</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>0.24 0.19 0.15</size></box></geometry>
          <material><ambient>0.55 0.42 0.20 1</ambient><diffuse>0.55 0.42 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rock 3 — ~50% path, north midfield. Placed in the wide open corridor
         (X=-3.60m, Y=18.72m) with 2.5m LEFT and 2.0m RIGHT clearance for smooth avoidance. -->
    <model name='rock_3_north_midfield'>
      <static>true</static>
      <pose>-3.60 18.72 0.18 0 0 0.7</pose>
      <link name='body_main'>
        <collision name='col_main'>
          <geometry><box><size>0.60 0.46 0.36</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name='vis_main'>
          <geometry><box><size>0.60 0.46 0.36</size></box></geometry>
          <material>
            <ambient>0.42 0.30 0.18 1</ambient><diffuse>0.42 0.30 0.18 1</diffuse>
            <specular>0.05 0.04 0.03 1</specular>
          </material>
        </visual>
      </link>
      <link name='lobe1'>
        <pose>0.20 0.15 -0.04 0.1 -0.15 0</pose>
        <collision name='col'><geometry><sphere><radius>0.18</radius></sphere></geometry></collision>
        <visual name='vis'>
          <geometry><sphere><radius>0.18</radius></sphere></geometry>
          <material><ambient>0.36 0.26 0.16 1</ambient><diffuse>0.36 0.26 0.16 1</diffuse></material>
        </visual>
      </link>
      <link name='lobe2'>
        <pose>-0.17 -0.11 -0.06 -0.05 0.1 0</pose>
        <collision name='col'><geometry><box><size>0.26 0.20 0.17</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>0.26 0.20 0.17</size></box></geometry>
          <material><ambient>0.55 0.40 0.18 1</ambient><diffuse>0.55 0.40 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rock 5 — ~82% path, south finish. Shifted 0.4m toward centre of corridor
         (original x=5.911 had only 0.5m LEFT, shifted to x=5.500).
         Clearance RIGHT=1.4m clearly open. -->
    <model name='rock_5_south_finish'>
      <static>true</static>
      <pose>5.500 8.313 0.14 0 0 0.3</pose>
      <link name='body_main'>
        <collision name='col_main'>
          <geometry><box><size>0.49 0.38 0.29</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name='vis_main'>
          <geometry><box><size>0.49 0.38 0.29</size></box></geometry>
          <material>
            <ambient>0.52 0.40 0.26 1</ambient><diffuse>0.52 0.40 0.26 1</diffuse>
            <specular>0.05 0.04 0.03 1</specular>
          </material>
        </visual>
      </link>
      <link name='lobe1'>
        <pose>0.16 0.12 -0.03 0.1 -0.15 0</pose>
        <collision name='col'><geometry><sphere><radius>0.15</radius></sphere></geometry></collision>
        <visual name='vis'>
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.44 0.34 0.22 1</ambient><diffuse>0.44 0.34 0.22 1</diffuse></material>
        </visual>
      </link>
      <link name='lobe2'>
        <pose>-0.14 -0.09 -0.04 -0.05 0.1 0</pose>
        <collision name='col'><geometry><box><size>0.21 0.17 0.14</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>0.21 0.17 0.14</size></box></geometry>
          <material><ambient>0.58 0.44 0.22 1</ambient><diffuse>0.58 0.44 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    
  </world>
</sdf>
