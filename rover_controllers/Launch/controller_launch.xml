<launch>

    <!-- Controller Manager -->
    <node
        pkg="controller_manager"
        exec="ros2_control_node"
        name="controller_manager"
        output="screen">
        
        <param from="$(find-pkg-share rover_controllers)/config/diff_controller.yaml"/>
    </node>

    <!-- Joint State Broadcaster Spawner -->
    <node
        pkg="controller_manager"
        exec="spawner"
        name="joint_state_broadcaster_spawner"
        args="joint_state_broadcaster --controller-manager /controller_manager"
        output="screen"/>

    <!-- Diff Drive Controller Spawner -->
    <node
        pkg="controller_manager"
        exec="spawner"
        name="rover_controller_spawner"
        args="rover_controller --controller-manager /controller_manager"
        output="screen"/>

    <!-- Joystick Node -->
    <node
        pkg="joy"
        exec="joy_node"
        name="joy_node"
        output="screen">

        <param from="$(find-pkg-share rover_controllers)/config/joyConfig.yaml"/>
    </node>

    <!-- Teleop Twist Joy -->
    <node
        pkg="teleop_twist_joy"
        exec="teleop_node"
        name="teleop_twist_joy"
        output="screen">

        <param from="$(find-pkg-share rover_controllers)/config/joyTeleop.yaml"/>

    </node>

</launch>