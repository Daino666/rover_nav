Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Pure Pursuit Path (stops at each waypoint)
      Topic:
        Value: /pure_pursuit/path
        Durability Policy: Transient Local
      Color: 42; 120; 214
      Line Style: Lines
      Line Width: 0.06
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Waypoints
      Topic:
        Value: /global_path/waypoints
        Durability Policy: Transient Local
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Enabled: false
  Global Options:
    Fixed Frame: odom
    Background Color: 255; 255; 255
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      X: 0
      Y: 0
