Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Occupancy Map
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
      Alpha: 0.6
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Global route
      Topic:
        Value: /pure_pursuit/path
        Durability Policy: Transient Local
      Color: 42; 120; 214
      Line Style: Lines
      Line Width: 0.06
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Local plan (what is being driven)
      Topic:
        Value: /local_plan
        Durability Policy: Transient Local
      Color: 20; 170; 60
      Line Style: Lines
      Line Width: 0.09
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Waypoints
      Topic:
        Value: /global_path/waypoints
        Durability Policy: Transient Local
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Keepouts + camera cone
      Topic:
        Value: /local_plan/markers
        Durability Policy: Volatile
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Detected obstacles (raw)
      Topic:
        Value: /obstacles/markers
        Durability Policy: Volatile
      Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Enabled: false
  Global Options:
    Fixed Frame: odom
    Background Color: 255; 255; 255
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 22
      X: 2
      Y: 9
